<UserControl x:Class="EzCompany.Modules.Legal.LegalContractDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:EzCompany.Modules.Legal">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="DiffRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Added}">
                    <Setter Property="Background" Value="#332EA043" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Deleted}">
                    <Setter Property="Background" Value="#33F85149" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Modified}">
                    <Setter Property="Background" Value="#33D29922" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Pháp chế — So sánh Hợp đồng .docx Offline" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding OriginalPath}" IsReadOnly="True" PlaceholderText="Hợp đồng gốc (.docx)..." />
                <ui:Button Grid.Column="2" Content="Chọn Gốc..." Command="{Binding BrowseOriginalCommand}" />
                <ui:TextBox Grid.Column="4" Text="{Binding RevisedPath}" IsReadOnly="True" PlaceholderText="Hợp đồng sửa đổi (.docx)..." />
                <ui:Button Grid.Column="6" Content="Chọn Mới..." Command="{Binding BrowseRevisedCommand}" />
            </Grid>

            <WrapPanel>
                <ui:TextBox Text="{Binding ReviewTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tiêu đề hồ sơ thẩm định..." Width="220" Margin="0,0,8,4" />
                <ui:Button Appearance="Primary" Content="So sánh ngay" Command="{Binding RunCompareCommand}" Margin="0,0,8,4" />
                <ui:Button Content="Prev Change" Command="{Binding PreviousChangeCommand}" Margin="0,0,6,4" />
                <ui:Button Content="Next Change" Command="{Binding NextChangeCommand}" Margin="0,0,10,4" />
                <CheckBox Content="Chế độ Inline" IsChecked="{Binding IsInlineView}" VerticalAlignment="Center" Margin="0,0,12,4" />
                <TextBlock Text="{Binding StatsSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>

        <!-- Diff grids -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="SideBySideGrid"
                      ItemsSource="{Binding SideBySideLines}"
                      SelectedItem="{Binding SelectedSideBySideLine}"
                      RowStyle="{StaticResource DiffRowStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionChanged="DiffGrid_SelectionChanged">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInlineView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding OldLineNumber}" Width="45" />
                    <DataGridTextColumn Header="Phiên bản gốc" Binding="{Binding OldText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding NewLineNumber}" Width="45" />
                    <DataGridTextColumn Header="Phiên bản sửa đổi" Binding="{Binding NewText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="InlineGrid"
                      ItemsSource="{Binding InlineLines}"
                      SelectedItem="{Binding SelectedInlineLine}"
                      RowStyle="{StaticResource DiffRowStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Visibility="{Binding IsInlineView, Converter={StaticResource BoolVis}}"
                      SelectionChanged="DiffGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="+/-" Binding="{Binding Prefix}" Width="40" />
                    <DataGridTextColumn Header="Nội dung so sánh Inline" Binding="{Binding Text}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ui:TextBox Text="{Binding ReviewerNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập ghi chú thẩm định pháp chế..." Margin="0,0,0,8" />
            <WrapPanel>
                <ui:Button Appearance="Primary" Content="Lưu Vault (SHA-256) &amp; CSDL" Command="{Binding SaveToVaultCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Xuất Báo cáo .html" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Xuất Báo cáo .docx" Command="{Binding ExportDocxCommand}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
