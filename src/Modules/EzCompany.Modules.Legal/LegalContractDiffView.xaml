<UserControl x:Class="EzCompany.Modules.Legal.LegalContractDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:EzCompany.Modules.Legal">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="DiffRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Added}">
                    <Setter Property="Background" Value="#332EA043" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Deleted}">
                    <Setter Property="Background" Value="#33F85149" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ContractDiffKind.Modified}">
                    <Setter Property="Background" Value="#33D29922" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Pháp chế — So sánh Hợp đồng &amp; Sổ Quản lý Hiệu lực" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.82" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- Tab 1: Contract Diff -->
            <TabItem Header="1. So sánh Hợp đồng (.docx Diff)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding OriginalPath}" IsReadOnly="True" PlaceholderText="Hợp đồng gốc (.docx)..." />
                            <ui:Button Grid.Column="2" Content="Chọn Gốc..." Command="{Binding BrowseOriginalCommand}" />
                            <ui:TextBox Grid.Column="4" Text="{Binding RevisedPath}" IsReadOnly="True" PlaceholderText="Hợp đồng sửa đổi (.docx)..." />
                            <ui:Button Grid.Column="6" Content="Chọn Mới..." Command="{Binding BrowseRevisedCommand}" />
                        </Grid>

                        <WrapPanel>
                            <ui:TextBox Text="{Binding ReviewTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tiêu đề hồ sơ thẩm định..." Width="220" Margin="0,0,8,4" />
                            <ui:Button Appearance="Primary" Content="So sánh ngay" Command="{Binding RunCompareCommand}" Margin="0,0,8,4" />
                            <ui:Button Content="Prev Change" Command="{Binding PreviousChangeCommand}" Margin="0,0,6,4" />
                            <ui:Button Content="Next Change" Command="{Binding NextChangeCommand}" Margin="0,0,10,4" />
                            <CheckBox Content="Chế độ Inline" IsChecked="{Binding IsInlineView}" VerticalAlignment="Center" Margin="0,0,12,4" />
                            <TextBlock Text="{Binding StatsSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Diff grids -->
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="SideBySideGrid"
                                  ItemsSource="{Binding SideBySideLines}"
                                  SelectedItem="{Binding SelectedSideBySideLine}"
                                  RowStyle="{StaticResource DiffRowStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="DiffGrid_SelectionChanged">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInlineView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding OldLineNumber}" Width="45" />
                                <DataGridTextColumn Header="Phiên bản gốc" Binding="{Binding OldText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding NewLineNumber}" Width="45" />
                                <DataGridTextColumn Header="Phiên bản sửa đổi" Binding="{Binding NewText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid x:Name="InlineGrid"
                                  ItemsSource="{Binding InlineLines}"
                                  SelectedItem="{Binding SelectedInlineLine}"
                                  RowStyle="{StaticResource DiffRowStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Visibility="{Binding IsInlineView, Converter={StaticResource BoolVis}}"
                                  SelectionChanged="DiffGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="+/-" Binding="{Binding Prefix}" Width="40" />
                                <DataGridTextColumn Header="Nội dung so sánh Inline" Binding="{Binding Text}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <ui:TextBox Text="{Binding ReviewerNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập ghi chú thẩm định pháp chế..." Margin="0,0,0,8" />
                        <WrapPanel>
                            <ui:Button Appearance="Primary" Content="Lưu Vault (SHA-256) &amp; CSDL" Command="{Binding SaveToVaultCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Xuất Báo cáo .html" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Xuất Báo cáo .docx" Command="{Binding ExportDocxCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Contract Registry & Expiration Monitor -->
            <TabItem Header="2. Sổ Quản lý Hợp đồng &amp; Nhắc hạn">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Contract KPI -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                        <Border Padding="12" Margin="0,0,6,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Tổng số Hợp đồng" Opacity="0.72" FontSize="12" />
                                <TextBlock Text="{Binding TotalContractsCount}" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12" Margin="3,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Sắp hết hạn (≤ 30 ngày)" Opacity="0.72" FontSize="12" />
                                <TextBlock Text="{Binding ExpiringSoonContractsCount}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12" Margin="6,0,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Đã hết hạn" Opacity="0.72" FontSize="12" />
                                <TextBlock Text="{Binding ExpiredContractsCount}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Add / Edit Form -->
                    <Border Grid.Row="1" Padding="12" Margin="0,0,0,10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding EditContractNumber, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Số HĐ..." />
                                <ui:TextBox Grid.Column="2" Text="{Binding EditContractTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tên / Nội dung hợp đồng..." />
                                <ui:TextBox Grid.Column="4" Text="{Binding EditCounterpartyName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Đối tác / Khách hàng..." />
                                <ComboBox Grid.Column="6" ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding EditContractType}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày ký" FontSize="11" Opacity="0.72" />
                                    <DatePicker SelectedDate="{Binding EditSignedDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hiệu lực từ" FontSize="11" Opacity="0.72" />
                                    <DatePicker SelectedDate="{Binding EditStartDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Ngày hết hạn" FontSize="11" Opacity="0.72" />
                                    <DatePicker SelectedDate="{Binding EditExpiryDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Giá trị (VNĐ)" FontSize="11" Opacity="0.72" />
                                    <ui:TextBox Text="{Binding EditValueVndText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Ghi chú &amp; Tệp đính kèm" FontSize="11" Opacity="0.72" />
                                    <ui:TextBox Text="{Binding EditContractNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ghi chú điều khoản..." />
                                </StackPanel>
                                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button Content="Đính kèm..." Command="{Binding BrowseContractAttachmentCommand}" Margin="0,0,6,0" />
                                    <ui:Button Content="Tạo mới" Command="{Binding NewContractFormCommand}" Margin="0,0,6,0" />
                                    <ui:Button Appearance="Primary" Content="Lưu Hợp đồng" Command="{Binding SaveContractCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Filter & Actions -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <ui:TextBox Text="{Binding ContractSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tìm số HĐ, tên, đối tác..." Width="220" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ContractStatusFilters}" SelectedItem="{Binding ContractStatusFilter}" Width="135" Margin="0,0,10,0" />
                        <ui:Button Appearance="Primary" Content="📅 Đẩy mốc hết hạn lên Timeline chung" Command="{Binding PushContractExpiryToTimelineCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Mở tệp đính kèm" Command="{Binding OpenContractAttachmentCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Xóa HĐ" Command="{Binding DeleteSelectedContractCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Xuất Excel (.xlsx)" Command="{Binding ExportContractsExcelCommand}" />
                    </WrapPanel>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding Contracts}"
                              SelectedItem="{Binding SelectedContract}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số HĐ" Binding="{Binding ContractNumber}" Width="110" />
                            <DataGridTextColumn Header="Tên hợp đồng" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Đối tác" Binding="{Binding CounterpartyName}" Width="160" />
                            <DataGridTextColumn Header="Loại" Binding="{Binding ContractType}" Width="90" />
                            <DataGridTextColumn Header="Ngày hết hạn" Binding="{Binding ExpiryDateKey}" Width="100" />
                            <DataGridTextColumn Header="Giá trị" Binding="{Binding ValueVnd, StringFormat=N0}" Width="110" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="105" />
                            <DataGridTextColumn Header="Tệp" Binding="{Binding FileName}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
