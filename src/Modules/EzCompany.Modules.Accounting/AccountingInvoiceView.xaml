<UserControl x:Class="EzCompany.Modules.Accounting.AccountingInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kế toán — Kiểm tra Hóa đơn Điện tử XML (NĐ 123 &amp; NĐ 70/2025)" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Content="Quét tệp XML..." Command="{Binding ImportXmlFilesCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Xuất Excel (.xlsx)" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Làm mới" Command="{Binding LoadSavedCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ký hiệu" Binding="{Binding InvoiceSeries}" Width="90" />
                <DataGridTextColumn Header="Số HĐ" Binding="{Binding InvoiceNumber}" Width="80" />
                <DataGridTextColumn Header="MST Bán" Binding="{Binding SellerTaxCode}" Width="110" />
                <DataGridTextColumn Header="Tên Người bán" Binding="{Binding SellerName}" Width="180" />
                <DataGridTextColumn Header="MST/CCCD Mua" Binding="{Binding BuyerTaxCodeOrCccd}" Width="120" />
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" Width="115" />
                <DataGridCheckBoxColumn Header="Trùng" Binding="{Binding IsDuplicate}" Width="60" />
                <DataGridCheckBoxColumn Header="Lệch >10đ" Binding="{Binding HasMathMismatch}" Width="75" />
                <DataGridTextColumn Header="Ghi chú &amp; Cảnh báo" Binding="{Binding ValidationNotes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Tệp XML gốc được lưu nguyên vẹn vào Vault/Accounting/Invoices/." FontSize="12" Opacity="0.65" Margin="0,8,0,0" />
    </Grid>
</UserControl>
