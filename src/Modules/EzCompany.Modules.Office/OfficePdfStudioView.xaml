<UserControl x:Class="EzCompany.Modules.Office.OfficePdfStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Văn phòng — Local PDF Studio (Offline)" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="Lưu kèm vào Vault/Office/"
                      IsChecked="{Binding SaveToVault}"
                      VerticalAlignment="Center" />
        </Grid>

        <TabControl Grid.Row="1">
            <!-- Tab 1: Merge PDF -->
            <TabItem Header="1. Gộp PDF">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <ui:Button Appearance="Primary" Content="Thêm tệp PDF..." Command="{Binding AddMergeFilesCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Lên" Command="{Binding MoveMergeUpCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Xuống" Command="{Binding MoveMergeDownCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Xóa chọn" Command="{Binding RemoveSelectedMergeFileCommand}" />
                    </WrapPanel>

                    <ListBox x:Name="MergeListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding MergeFiles}"
                             SelectedItem="{Binding SelectedMergeFile}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="MergeListBox_PreviewMouseLeftButtonDown"
                             Drop="MergeListBox_Drop" />

                    <ui:Button Grid.Row="2"
                               Margin="0,12,0,0"
                               Appearance="Primary"
                               Content="Gộp thành 1 tệp PDF"
                               Command="{Binding ExecuteMergeCommand}" />
                </Grid>
            </TabItem>

            <!-- Tab 2: Split PDF -->
            <TabItem Header="2. Tách trang">
                <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Tệp PDF nguồn" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding SplitInputPath}" IsReadOnly="True" />
                        <ui:Button Grid.Column="2" Content="Chọn PDF..." Command="{Binding BrowseSplitInputCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SplitInputInfo}" Opacity="0.75" Margin="0,0,0,10" />

                    <TextBlock Text="Khoảng trang cần tách (ví dụ: 1-3, 5)" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding SplitRanges, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <ui:Button Appearance="Primary" Content="Tách trang PDF" Command="{Binding ExecuteSplitCommand}" />
                </StackPanel>
            </TabItem>

            <!-- Tab 3: Rotate PDF -->
            <TabItem Header="3. Xoay trang">
                <StackPanel Margin="12" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Tệp PDF nguồn" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding RotateInputPath}" IsReadOnly="True" />
                        <ui:Button Grid.Column="2" Content="Chọn PDF..." Command="{Binding BrowseRotateInputCommand}" />
                    </Grid>

                    <TextBlock Text="Góc xoay (độ)" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RotationAngles}" SelectedItem="{Binding RotateDegrees}" Width="140" Margin="0,0,0,10" HorizontalAlignment="Left" />

                    <TextBlock Text="Trang áp dụng (để trống = tất cả các trang)" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding RotateRanges, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="vd: 1, 3-4" Margin="0,0,0,14" />

                    <ui:Button Appearance="Primary" Content="Xoay trang &amp; Xuất PDF" Command="{Binding ExecuteRotateCommand}" />
                </StackPanel>
            </TabItem>

            <!-- Tab 4: Diagonal Watermark -->
            <TabItem Header="4. Đóng dấu Watermark chéo">
                <StackPanel Margin="12" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Text="Tệp PDF nguồn" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding WatermarkInputPath}" IsReadOnly="True" />
                        <ui:Button Grid.Column="2" Content="Chọn PDF..." Command="{Binding BrowseWatermarkInputCommand}" />
                    </Grid>

                    <TextBlock Text="Nội dung Watermark" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="Kèm ngày giờ" IsChecked="{Binding WatermarkIncludeTimestamp}" Margin="0,0,14,0" />
                        <CheckBox Content="Kèm tên tài khoản" IsChecked="{Binding WatermarkIncludeUsername}" />
                    </WrapPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Độ mờ (Opacity)" />
                            <Slider Minimum="0.08" Maximum="0.90" Value="{Binding WatermarkOpacity}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cỡ chữ" />
                            <ui:TextBox Text="{Binding WatermarkFontSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Màu Hex" />
                            <ui:TextBox Text="{Binding WatermarkColorHex, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button Appearance="Primary" Content="Đóng dấu Watermark &amp; Xuất PDF" Command="{Binding ExecuteWatermarkCommand}" />
                </StackPanel>
            </TabItem>

            <!-- Tab 5: Images to PDF -->
            <TabItem Header="5. Ảnh → PDF">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <ui:Button Appearance="Primary" Content="Thêm ảnh (PNG/JPG)..." Command="{Binding AddImagesToPdfCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Xóa ảnh đang chọn" Command="{Binding RemoveSelectedImageToPdfCommand}" Margin="0,0,14,0" />
                        <CheckBox Content="Căn vừa khổ giấy A4" IsChecked="{Binding ImageFitToA4}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ImageToPdfFiles}"
                             SelectedItem="{Binding SelectedImageToPdfFile}" />

                    <ui:Button Grid.Row="2"
                               Margin="0,12,0,0"
                               Appearance="Primary"
                               Content="Xuất tệp PDF từ danh sách ảnh"
                               Command="{Binding ExecuteImagesToPdfCommand}" />
                </Grid>
            </TabItem>

            <!-- Tab 6: Stamp Signature / Seal Image -->
            <TabItem Header="6. Chèn Chữ ký / Con dấu">
                <StackPanel Margin="12" MaxWidth="660" HorizontalAlignment="Left">
                    <TextBlock Text="Tệp PDF gốc" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding StampInputPdfPath}" IsReadOnly="True" />
                        <ui:Button Grid.Column="2" Content="Chọn PDF..." Command="{Binding BrowseStampPdfCommand}" />
                    </Grid>

                    <TextBlock Text="Ảnh chữ ký / con dấu (khuyến nghị PNG nền trong suốt)" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding StampImagePath}" IsReadOnly="True" />
                        <ui:Button Grid.Column="2" Content="Chọn ảnh..." Command="{Binding BrowseStampImageCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Trang số" />
                            <ui:TextBox Text="{Binding StampPageNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding StampXPercent, StringFormat='Vị trí X: {0:F0}%'}" />
                            <Slider Minimum="0" Maximum="90" Value="{Binding StampXPercent}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding StampYPercent, StringFormat='Vị trí Y: {0:F0}%'}" />
                            <Slider Minimum="0" Maximum="90" Value="{Binding StampYPercent}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{Binding StampWidthPercent, StringFormat='Cỡ rộng: {0:F0}%'}" />
                            <Slider Minimum="5" Maximum="60" Value="{Binding StampWidthPercent}" />
                        </StackPanel>
                    </Grid>

                    <ui:Button Appearance="Primary" Content="Chèn ảnh Chữ ký / Con dấu &amp; Lưu PDF" Command="{Binding ExecuteStampImageCommand}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
