<UserControl x:Class="EzCompany.App.Views.DbInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Read-Only DB Inspector (Kiểm tra bản chụp từ máy Nhân viên)" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding SnapshotHeader}" Opacity="0.85" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Primary" Content="Mở tệp .db bản chụp..." Command="{Binding BrowseAndLoadCommand}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Hóa đơn XML (Kế toán)">
                <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ký hiệu" Binding="{Binding InvoiceSeries}" Width="90" />
                        <DataGridTextColumn Header="Số HĐ" Binding="{Binding InvoiceNumber}" Width="80" />
                        <DataGridTextColumn Header="MST Bán" Binding="{Binding SellerTaxCode}" Width="110" />
                        <DataGridTextColumn Header="Người bán" Binding="{Binding SellerName}" Width="180" />
                        <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120" />
                        <DataGridCheckBoxColumn Header="Trùng" Binding="{Binding IsDuplicate}" Width="60" />
                        <DataGridCheckBoxColumn Header="Lệch" Binding="{Binding HasMathMismatch}" Width="60" />
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding ValidationNotes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Thẩm định Hợp đồng (Pháp chế)">
                <DataGrid ItemsSource="{Binding ContractReviews}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="180" />
                        <DataGridTextColumn Header="Bản gốc" Binding="{Binding OriginalFileName}" Width="150" />
                        <DataGridTextColumn Header="Bản sửa" Binding="{Binding RevisedFileName}" Width="150" />
                        <DataGridTextColumn Header="+" Binding="{Binding AddedCount}" Width="45" />
                        <DataGridTextColumn Header="-" Binding="{Binding DeletedCount}" Width="45" />
                        <DataGridTextColumn Header="~" Binding="{Binding ModifiedCount}" Width="45" />
                        <DataGridTextColumn Header="Ghi chú thẩm định" Binding="{Binding ReviewerNotes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Nhật ký AuditLogs">
                <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleId}" Width="140" />
                        <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="170" />
                        <DataGridTextColumn Header="Mục tiêu" Binding="{Binding TargetEntity}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
