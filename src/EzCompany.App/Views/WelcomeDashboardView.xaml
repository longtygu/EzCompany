<UserControl x:Class="EzCompany.App.Views.WelcomeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootControl">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource AppCardMaxWidth}" HorizontalAlignment="Stretch">
            <!-- Top-left Greeting + Date (Solar & Vietnamese Lunar) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding GreetingText}"
                               FontSize="{DynamicResource AppFontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}" />
                    <TextBlock Text="{Binding UserRoleAndCompanyText}"
                               FontSize="{DynamicResource AppFontSizeSmall}"
                               Opacity="0.8"
                               Margin="0,4,0,10" />
                    <Border Padding="{DynamicResource AppCardPadding}"
                            CornerRadius="{DynamicResource AppCardCornerRadius}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding SolarDateText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LunarDateText}" Opacity="0.85" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                    <ui:Button Appearance="Primary"
                               Content="Làm mới"
                               Command="{Binding RefreshCommand}"
                               Margin="0,0,0,8" />
                    <ui:Button Appearance="Secondary"
                               Content="Mở Giao việc &amp; Bàn giao"
                               Command="{Binding OpenFullTaskWorkspaceCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusBanner}"
                       Margin="0,0,0,10"
                       Opacity="0.9"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusBanner, Converter={StaticResource NotEmptyToVis}}" />

            <!-- Progress Summary -->
            <Border Padding="{DynamicResource AppCardPadding}"
                    Margin="0,0,0,16"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tiến độ hoàn thành các task"
                                   FontSize="{DynamicResource AppFontSizeHeading}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CompletionPercentText}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="10"
                                 Margin="0,10,0,12"
                                 Value="{Binding CompletionPercent}" />
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Text="Task hôm nay" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.7" />
                            <TextBlock Text="{Binding SelfTodayCount}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Task được giao (đang mở)" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.7" />
                            <TextBlock Text="{Binding AssignedOpenCount}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Đã hoàn thành" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.7" />
                            <TextBlock Text="{Binding CompletedCount}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Quá hạn" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.7" />
                            <TextBlock Text="{Binding OverdueCount}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 2-Column Main Tasks Area -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Today Self-Created Tasks -->
                <Border Grid.Column="0"
                        Padding="{DynamicResource AppCardPadding}"
                        CornerRadius="{DynamicResource AppCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Task hôm nay (Tự tạo)"
                                   FontSize="{DynamicResource AppFontSizeHeading}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding NewSelfTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Nhập việc cần làm hôm nay..." />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding AvailablePriorities}"
                                      SelectedItem="{Binding NewSelfTaskPriority}" />
                            <ui:Button Grid.Column="4"
                                       Appearance="Primary"
                                       Content="Thêm"
                                       Command="{Binding AddSelfTaskCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TodaySelfTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0"
                                                       Margin="0,0,8,0"
                                                       Padding="8,4"
                                                       Content="{Binding Status}"
                                                       Command="{Binding DataContext.ToggleSelfTaskCommand, ElementName=RootControl}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Bấm để chuyển Hoàn thành / Mở lại" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Priority}" FontSize="11" Opacity="0.7" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="2"
                                                       Appearance="Transparent"
                                                       Content="Xóa"
                                                       Command="{Binding DataContext.DeleteSelfTaskCommand, ElementName=RootControl}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Assigned Tasks -->
                <Border Grid.Column="2"
                        Padding="{DynamicResource AppCardPadding}"
                        CornerRadius="{DynamicResource AppCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Task được giao"
                                   FontSize="{DynamicResource AppFontSizeHeading}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <ListBox ItemsSource="{Binding AssignedToMeTasks}"
                                 SelectedItem="{Binding SelectedAssignedTask}"
                                 MaxHeight="210"
                                 Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Người giao: " FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding AssignerFullName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.85" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Priority}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ui:TextBox Text="{Binding QuickHandoverNotes, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ghi chú kết quả bàn giao nhanh cho task đang chọn..."
                                    Margin="0,0,0,8" />
                        <WrapPanel>
                            <ui:Button Content="Bắt đầu làm"
                                       Command="{Binding StartSelectedAssignedTaskCommand}"
                                       Margin="0,0,8,6" />
                            <ui:Button Appearance="Primary"
                                       Content="Bàn giao nhanh"
                                       Command="{Binding SubmitQuickHandoverCommand}"
                                       Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Completed Tasks History -->
            <Border Padding="{DynamicResource AppCardPadding}"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Lịch sử hoàn thành các task"
                               FontSize="{DynamicResource AppFontSizeHeading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding CompletedTasksHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="230">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Loại" Binding="{Binding TaskKind}" Width="85" />
                            <DataGridTextColumn Header="Người giao" Binding="{Binding AssignerFullName}" Width="140" />
                            <DataGridTextColumn Header="Người làm" Binding="{Binding AssigneeFullName}" Width="140" />
                            <DataGridTextColumn Header="Kết quả bàn giao" Binding="{Binding HandoverNotes}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
