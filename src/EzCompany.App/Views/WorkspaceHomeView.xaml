<UserControl x:Class="EzCompany.App.Views.WorkspaceHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860">
            <TextBlock Text="{Binding CompanyTitle}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding UserSubtitle}" Margin="0,4,0,20" Opacity="0.8" />

            <Border Padding="16"
                    Margin="0,0,0,16"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Trạng thái Giấy phép &amp; Bảo mật Cục bộ (policy.lic + clock.guard)"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PolicySummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StorageSummary}" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Thông tin Phiên, Mạng LAN &amp; Nhật ký Cục bộ" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LanSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogSummary}" Margin="0,6,0,10" Opacity="0.75" TextWrapping="Wrap" />
                    <ui:Button Content="Mở thư mục Logs" Command="{Binding OpenLogsFolderCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
