<UserControl x:Class="EzCompany.App.Views.ChatWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="ChatRoot">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Conversations, Start DM, Create Group -->
        <Border Grid.Column="0"
                Padding="{DynamicResource AppCardPadding}"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Chat nội bộ P2P" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                        <ui:Button Grid.Column="1" Content="Truy xuất LAN" Command="{Binding ReversePullHistoryFromLanCommand}" ToolTip="Kéo ngược lịch sử tin nhắn &amp; file từ các máy LAN" />
                    </Grid>

                    <TextBlock Text="Chat riêng (1-1)" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.75" Margin="0,10,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedDirectPeer}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Content="Mở" Command="{Binding StartDirectChatCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="Tạo nhóm chat mới" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.75" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tên nhóm (vd: Kế toán - Pháp chế)..." Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding GroupMemberChoices}" MaxHeight="95" Margin="0,0,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding FullName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ui:Button HorizontalAlignment="Stretch" Appearance="Secondary" Content="Tạo nhóm chat" Command="{Binding CreateGroupCommand}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ConversationType}" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Column: Pinned Task + Messages + Composer -->
        <Border Grid.Column="2"
                Padding="{DynamicResource AppCardPadding}"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
                <!-- Header & Pinned WorkTask Bar -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedConversation.Name}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                            <TextBlock Text="{Binding StatusBanner}" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.8" Visibility="{Binding StatusBanner, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Làm mới" Command="{Binding RefreshAllCommand}" />
                    </Grid>

                    <!-- Pinned Task Banner -->
                    <Border Padding="10,8"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Visibility="{Binding SelectedConversation.PinnedTaskSummary, Converter={StaticResource NotEmptyToVis}}">
                        <StackPanel>
                            <TextBlock Text="CÔNG VIỆC ĐANG GHIM TRONG NHÓM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                            <TextBlock Text="{Binding SelectedConversation.PinnedTaskSummary}" TextWrapping="Wrap" Margin="0,2,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Pin Task Picker -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding PinnableTasks}" SelectedItem="{Binding SelectedTaskToPin}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Content="📌 Ghim công việc vào chat" Command="{Binding PinSelectedTaskCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Bottom Message Composer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding DraftAttachmentPath, StringFormat='Tệp đính kèm: {0}'}"
                               FontSize="11"
                               Opacity="0.8"
                               Margin="0,0,0,4"
                               Visibility="{Binding DraftAttachmentPath, Converter={StaticResource NotEmptyToVis}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="📎 Đính kèm" Command="{Binding BrowseAttachmentCommand}" />
                        <ui:TextBox Grid.Column="2" Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập tin nhắn trao đổi nội bộ..." />
                        <ui:Button Grid.Column="4" Appearance="Primary" Content="Gửi tin nhắn" Command="{Binding SendMessageCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Message Stream -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SenderFullName}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SentTimeLocal}" FontSize="11" Opacity="0.65" />
                                        </Grid>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Content, Converter={StaticResource NotEmptyToVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AttachmentFileName, StringFormat='📎 {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <ui:Button Content="Mở / Tải ngược từ LAN"
                                                       Padding="8,4"
                                                       Command="{Binding DataContext.OpenOrRetrieveAttachmentCommand, ElementName=ChatRoot}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
