<UserControl x:Class="EzCompany.App.Views.ChatWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="ChatRoot">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Compact Bar: Circular Employee Avatars with Blinking Green (Online) / Red (Offline) Status + Pop-Out Button -->
        <Border Grid.Row="0"
                Padding="12,8"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppCardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Nhân sự" FontWeight="Bold" FontSize="{DynamicResource AppFontSizeSmall}" />
                    <TextBlock Text="{Binding OnlinePeersSummary}" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PeerPresenceItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        Margin="0,0,8,0"
                                        Cursor="Hand"
                                        ToolTip="{Binding ToolTipText}"
                                        Command="{Binding DataContext.StartDirectChatWithPeerCommand, ElementName=ChatRoot}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Width="56" HorizontalAlignment="Center">
                                        <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                            <Border Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                                                <Grid>
                                                    <Ellipse Width="40" Height="40" Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <ui:SymbolIcon Symbol="Person24"
                                                                   FontSize="20"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasAvatarImage, Converter={StaticResource InvBoolToVis}}" />
                                                </Grid>
                                            </Border>

                                            <!-- Blinking Green Online Dot -->
                                            <Ellipse Width="12"
                                                     Height="12"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="#22C55E"
                                                     Stroke="{DynamicResource AppCardBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.85" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Blinking Red Offline Dot -->
                                            <Ellipse Width="12"
                                                     Height="12"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="#EF4444"
                                                     Stroke="{DynamicResource AppCardBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.20" Duration="0:0:1.05" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>

                                        <TextBlock Text="{Binding ShortName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ui:Button Grid.Column="4"
                           Appearance="Secondary"
                           Content="{Binding DetachButtonText}"
                           Command="{Binding ToggleDetachChatWindowCommand}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 2: Conversations + Search Left | Active Chat Stream + Stickers + Composer Right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Header + Create Group Window Launcher + Search Employee Dropdown + Conversations -->
            <Border Grid.Column="0"
                    Padding="{DynamicResource AppCardPadding}"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Chat nội bộ" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                                <TextBlock Text="● Tự động cập nhật 1s" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Appearance="Primary"
                                       Content="+ Tạo nhóm"
                                       Padding="9,5"
                                       Command="{Binding RequestOpenCreateGroupWindowCommand}"
                                       ToolTip="Mở cửa sổ riêng tạo nhóm chat mới" />
                            <ui:Button Grid.Column="3"
                                       Content="LAN"
                                       Padding="9,5"
                                       Command="{Binding ReversePullHistoryFromLanCommand}"
                                       ToolTip="Truy xuất ngược lịch sử tin nhắn &amp; file từ các máy LAN" />
                        </Grid>

                        <!-- Search employee by name or role (replaces ComboBox) -->
                        <TextBlock Text="Tìm nhân viên để chat riêng (Tên hoặc chức vụ)"
                                   FontSize="{DynamicResource AppFontSizeSmall}"
                                   Opacity="0.75"
                                   Margin="0,10,0,4" />
                        <ui:TextBox Text="{Binding PeerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Gõ tên hoặc chức vụ (vd: Kế toán, Châu)..." />

                        <!-- Dropdown list when typing -->
                        <Border Margin="0,4,0,0"
                                Padding="4"
                                CornerRadius="8"
                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                MaxHeight="190"
                                Visibility="{Binding IsPeerSearchDropdownOpen, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredPeerSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.StartDirectChatWithPeerCommand, ElementName=ChatRoot}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Background="{DynamicResource AppCardBackgroundBrush}">
                                                        <ui:SymbolIcon Symbol="Person24" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding RoleBilingual}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="3" Width="9" Height="9" VerticalAlignment="Center" Fill="#22C55E"
                                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                                    <Ellipse Grid.Column="3" Width="9" Height="9" VerticalAlignment="Center" Fill="#EF4444"
                                                             Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ConversationType}" FontSize="11" Opacity="0.65" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding LastUpdatedLocal}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            MinWidth="22"
                                            Height="22"
                                            Padding="6,2"
                                            CornerRadius="11"
                                            Background="{DynamicResource AppAccentBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Column: Pinned Task + Messages + Sticker Tray + Composer -->
            <Border Grid.Column="2"
                    Padding="{DynamicResource AppCardPadding}"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <DockPanel>
                    <!-- Header & Pinned WorkTask Bar -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedConversation.Name}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" />
                                <TextBlock Text="{Binding StatusBanner}" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.8" Visibility="{Binding StatusBanner, Converter={StaticResource NotEmptyToVis}}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Làm mới" Command="{Binding RefreshAllCommand}" />
                        </Grid>

                        <!-- Pinned Task Banner -->
                        <Border Padding="10,8"
                                Margin="0,0,0,8"
                                CornerRadius="8"
                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                Visibility="{Binding SelectedConversation.PinnedTaskSummary, Converter={StaticResource NotEmptyToVis}}">
                            <StackPanel>
                                <TextBlock Text="CÔNG VIỆC ĐANG GHIM TRONG NHÓM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="{Binding SelectedConversation.PinnedTaskSummary}" TextWrapping="Wrap" Margin="0,2,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Pin Task Picker -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding PinnableTasks}" SelectedItem="{Binding SelectedTaskToPin}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button Grid.Column="2" Content="📌 Ghim công việc vào chat" Command="{Binding PinSelectedTaskCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Bottom Message Composer & Custom Sticker Tray -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <!-- Custom Sticker Picker Tray -->
                        <Border Padding="10"
                                Margin="0,0,0,8"
                                CornerRadius="10"
                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                Visibility="{Binding IsStickerTrayOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bộ Sticker Tùy chỉnh (Bấm để gửi ngay)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1" Appearance="Primary" Content="+ Thêm Sticker..." Command="{Binding AddCustomStickerCommand}" Padding="10,5" />
                                </Grid>
                                <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Stickers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,8,8"
                                                        Padding="6"
                                                        Width="90"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppCardBackgroundBrush}"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource AppCardBorderBrush}">
                                                    <Grid>
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.SendStickerCommand, ElementName=ChatRoot}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Name}">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Image Source="{Binding PreviewImage}" Width="64" Height="64" Stretch="Uniform" />
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="✕"
                                                                Width="20"
                                                                Height="20"
                                                                Padding="0"
                                                                FontSize="10"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Opacity="0.7"
                                                                ToolTip="Xóa sticker này"
                                                                Command="{Binding DataContext.DeleteCustomStickerCommand, ElementName=ChatRoot}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DraftAttachmentPath, StringFormat='Tệp đính kèm: {0}'}"
                                   FontSize="11"
                                   Opacity="0.8"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding DraftAttachmentPath, Converter={StaticResource NotEmptyToVis}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="📎 Tệp" Command="{Binding BrowseAttachmentCommand}" />
                            <ui:Button Grid.Column="2" Content="☺ Sticker" Command="{Binding ToggleStickerTrayCommand}" />
                            <ui:TextBox x:Name="MessageInputBox"
                                        Grid.Column="4"
                                        Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Nhập tin nhắn (nhấn Enter để gửi, Shift+Enter xuống dòng)..."
                                        AcceptsReturn="True"
                                        PreviewKeyDown="MessageInputBox_PreviewKeyDown" />
                            <ui:Button Grid.Column="6" Appearance="Primary" Content="Gửi tin nhắn" Command="{Binding SendMessageCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Message Stream (Left/Right Chat Bubbles + Stickers) -->
                    <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <!-- Peer message bubble (Left) -->
                                        <Grid HorizontalAlignment="Left"
                                              MaxWidth="560"
                                              Visibility="{Binding IsOtherMessage, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource AppAccentBrush}">
                                                <TextBlock Text="{Binding SenderInitials}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Padding="12,9"
                                                    CornerRadius="4,12,12,12"
                                                    Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SenderFullName}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding SentTimeLocal}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Image Source="{Binding StickerImage}"
                                                           Width="128"
                                                           Height="128"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Left"
                                                           Visibility="{Binding IsSticker, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Content}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding IsSticker, Converter={StaticResource InvBoolToVis}}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasFileAttachment, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding AttachmentFileName, StringFormat='📎 {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <ui:Button Content="Mở / Tải ngược từ LAN"
                                                                   Padding="8,4"
                                                                   Command="{Binding DataContext.OpenOrRetrieveAttachmentCommand, ElementName=ChatRoot}"
                                                                   CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Own message bubble (Right) -->
                                        <Border HorizontalAlignment="Right"
                                                MaxWidth="560"
                                                Padding="12,9"
                                                CornerRadius="12,4,12,12"
                                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                                BorderThickness="1.5"
                                                BorderBrush="{DynamicResource AppAccentBrush}"
                                                Visibility="{Binding IsOwnMessage, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                                    <TextBlock Text="Bạn" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding SentTimeLocal}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Image Source="{Binding StickerImage}"
                                                       Width="128"
                                                       Height="128"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsSticker, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Content}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsSticker, Converter={StaticResource InvBoolToVis}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding HasFileAttachment, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding AttachmentFileName, StringFormat='📎 {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <ui:Button Content="Mở tệp"
                                                               Padding="8,4"
                                                               Command="{Binding DataContext.OpenOrRetrieveAttachmentCommand, ElementName=ChatRoot}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
