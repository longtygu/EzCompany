<UserControl x:Class="EzCompany.App.Views.HrAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="HrRoot">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource AppCardMaxWidth}" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Quản lý Nhân sự, Chấm công &amp; Tính lương Tự động" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TodayCheckStatus}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" />
                    <TextBlock Text="{Binding StatusBanner}" Margin="0,4,0,0" Opacity="0.85" TextWrapping="Wrap" Visibility="{Binding StatusBanner, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Primary" Content="Chấm công VÀO" Command="{Binding CheckInTodayCommand}" Margin="0,0,8,0" />
                <ui:Button Grid.Column="2" Appearance="Secondary" Content="Chấm công RA" Command="{Binding CheckOutTodayCommand}" Margin="0,0,8,0" />
                <ui:Button Grid.Column="3" Content="Làm mới" Command="{Binding RefreshAllCommand}" />
            </Grid>

            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Tab 1: Expandable Employee Profiles List + Add/Edit/Delete -->
                <TabItem Header="1. Hồ sơ Nhân viên">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding EmployeeSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Tìm nhân viên theo mã NV, họ tên, phòng ban hoặc chức danh..." />
                            <ui:Button Grid.Column="2" Appearance="Primary" Content="+ Thêm nhân viên" Command="{Binding OpenNewEmployeeEditorCommand}" />
                            <ui:Button Grid.Column="4" Content="Đồng bộ máy trạm LAN" Command="{Binding SyncFromLanDevicesCommand}" />
                        </Grid>

                        <!-- Collapsible Add/Edit Employee Drawer -->
                        <Border Padding="{DynamicResource AppCardPadding}"
                                Margin="0,0,0,14"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardBackgroundBrush}"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                Visibility="{Binding IsEmployeeEditorVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EditorModeTitle}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                    <ui:Button Grid.Column="1" Content="Đóng" Command="{Binding CancelEmployeeEditorCommand}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mã nhân viên (*)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditEmployeeCode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Họ và tên (*)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Phòng ban" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditDepartment, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chức danh công việc" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditPositionTitle, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Điện thoại" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Email" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Số CCCD" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditNationalId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Lương cơ bản (VNĐ)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditBaseSalaryVnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Phụ cấp (VNĐ)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditAllowanceVnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Ngày công chuẩn" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditStandardWorkDays, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Khấu trừ BHXH (VNĐ)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding EditInsuranceDeductionVnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="Ngày vào làm" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <DatePicker SelectedDate="{Binding EditJoinDate}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Vai trò kiêm nhiệm:" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,10,0,4" />
                                <WrapPanel>
                                    <CheckBox Content="Manager (Giám đốc)" IsChecked="{Binding EditRoleDirector}" Margin="0,0,10,4" />
                                    <CheckBox Content="Accounting (Kế toán)" IsChecked="{Binding EditRoleAccounting}" Margin="0,0,10,4" />
                                    <CheckBox Content="Legal (Pháp chế)" IsChecked="{Binding EditRoleLegal}" Margin="0,0,10,4" />
                                    <CheckBox Content="HR (Nhân sự)" IsChecked="{Binding EditRoleHr}" Margin="0,0,10,4" />
                                    <CheckBox Content="Staff (Nhân viên)" IsChecked="{Binding EditRoleStaff}" Margin="0,0,10,4" />
                                </WrapPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding EmploymentStatuses}" SelectedItem="{Binding EditEmploymentStatus}" />
                                    <ui:TextBox Grid.Column="2" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ghi chú hồ sơ..." />
                                    <ui:Button Grid.Column="4" Content="Hủy" Command="{Binding CancelEmployeeEditorCommand}" />
                                    <ui:Button Grid.Column="6" Appearance="Primary" Content="Lưu hồ sơ nhân viên" Command="{Binding SaveEmployeeCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Expandable Employee Profiles Accordion Cards -->
                        <ItemsControl ItemsSource="{Binding EmployeeCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            CornerRadius="{DynamicResource AppCardCornerRadius}"
                                            Background="{DynamicResource AppCardBackgroundBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AppCardBorderBrush}">
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <Expander.Header>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="95" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding EmployeeCode}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Department}" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RolesBilingual}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="4"
                                                            Padding="8,2"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding EmploymentStatus}" FontSize="11.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>

                                            <Border Margin="0,8,0,2"
                                                    Padding="12"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AppCardInnerBackgroundBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding PositionTitle, StringFormat='Chức danh: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding Phone, StringFormat='Điện thoại: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding Email, StringFormat='Email: {0}'}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding NationalId, StringFormat='CCCD: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding JoinDateText, StringFormat='Ngày vào làm: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding Notes, StringFormat='Ghi chú: {0}'}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="{Binding BaseSalaryText, StringFormat='Lương cơ bản: {0}'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding AllowanceText, StringFormat='Phụ cấp: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding StandardDaysText, StringFormat='Công chuẩn: {0}'}" Margin="0,0,0,4" />
                                                            <TextBlock Text="{Binding InsuranceDeductionText, StringFormat='Khấu trừ BHXH: {0}'}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <WrapPanel Margin="0,12,0,0">
                                                        <ui:Button Appearance="Primary"
                                                                   Content="Sửa hồ sơ"
                                                                   Command="{Binding DataContext.EditEmployeeCardCommand, ElementName=HrRoot}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="0,0,8,0" />
                                                        <ui:Button Appearance="Secondary"
                                                                   Content="Chấm công nhân viên này"
                                                                   Command="{Binding DataContext.QuickAttendEmployeeCommand, ElementName=HrRoot}"
                                                                   CommandParameter="{Binding}"
                                                                   Margin="0,0,8,0" />
                                                        <ui:Button Content="Xóa hồ sơ"
                                                                   Command="{Binding DataContext.DeleteEmployeeCardCommand, ElementName=HrRoot}"
                                                                   CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <!-- Tab 2: Custom Hour Attendance + Full Detail Window Launcher -->
                <TabItem Header="2. Chấm công Tùy chỉnh &amp; Báo cáo">
                    <StackPanel Margin="0,12,0,0">
                        <!-- Custom Hour Attendance Card -->
                        <Border Padding="{DynamicResource AppCardPadding}"
                                Margin="0,0,0,14"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Chấm công theo Giờ tùy chỉnh (Nhập chuẩn tránh sai lệch không có máy chấm công)"
                                           FontSize="{DynamicResource AppFontSizeHeading}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nhân viên" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding AttendanceTargetEmployee}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FullName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày chấm công" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <DatePicker SelectedDate="{Binding AttendanceWorkDate}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Giờ VÀO (HH:mm)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding AttendanceCheckInText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="08:00" />
                                            <ui:Button Grid.Column="2" Content="Hiện tại" Command="{Binding FillCurrentTimeCheckInCommand}" Padding="8,5" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Giờ RA (HH:mm)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding AttendanceCheckOutText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="17:30" />
                                            <ui:Button Grid.Column="2" Content="Hiện tại" Command="{Binding FillCurrentTimeCheckOutCommand}" Padding="8,5" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Trạng thái" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding AttendanceStatuses}" SelectedItem="{Binding AttendanceStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Số công" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding AttendanceWorkDayUnits, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Tăng ca (giờ)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding AttendanceOvertimeHours, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Ghi chú" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                                        <ui:TextBox Text="{Binding AttendanceNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Lý do / ca làm việc..." />
                                    </StackPanel>
                                    <ui:Button Grid.Column="8"
                                               VerticalAlignment="Bottom"
                                               Appearance="Primary"
                                               Content="Lưu chấm công tùy chỉnh"
                                               Command="{Binding SaveCustomAttendanceCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar & Open Full Attendance Window -->
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding SelectedMonth}" Width="80" Margin="0,0,12,0" />
                            <TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                            <ui:Button Appearance="Primary"
                                       Content="Mở Bảng chấm công Full theo Ngày (Cửa sổ riêng)"
                                       Command="{Binding OpenFullAttendanceWindowCommand}"
                                       Margin="0,0,10,0" />
                            <ui:Button Appearance="Secondary" Content="Xuất Báo cáo Chấm công (.xlsx)" Command="{Binding ExportMonthlyExcelCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Tổng hợp tháng theo nhân viên" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding MonthlySummary}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode}" Width="90" />
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding EmployeeName}" Width="*" />
                                <DataGridTextColumn Header="Đúng giờ" Binding="{Binding PresentDays}" Width="80" />
                                <DataGridTextColumn Header="Đi muộn" Binding="{Binding LateDays}" Width="80" />
                                <DataGridTextColumn Header="Nửa ngày" Binding="{Binding HalfDays}" Width="80" />
                                <DataGridTextColumn Header="Nghỉ phép" Binding="{Binding LeaveDays}" Width="80" />
                                <DataGridTextColumn Header="Vắng" Binding="{Binding AbsentDays}" Width="70" />
                                <DataGridTextColumn Header="Tổng giờ" Binding="{Binding TotalWorkedHours, StringFormat=F2}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- Tab 3: Automated Monthly Payroll -->
                <TabItem Header="3. Tính lương Tự động">
                    <StackPanel Margin="0,12,0,0">
                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock Text="Tháng:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding SelectedMonth}" Width="80" Margin="0,0,12,0" />
                            <TextBlock Text="Năm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                            <ui:Button Appearance="Primary" Content="Tính lại bảng lương" Command="{Binding RecalculatePayrollCommand}" Margin="0,0,10,0" />
                            <ui:Button Appearance="Secondary" Content="Xuất Bảng lương Excel (.xlsx)" Command="{Binding ExportPayrollExcelCommand}" />
                        </WrapPanel>

                        <Border Padding="{DynamicResource AppCardPadding}"
                                Margin="0,0,0,12"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Tổng hợp Quỹ lương Tháng" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PayrollSummaryText}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="Công thức: (Lương cơ bản × Công thực tế / Công chuẩn) + Phụ cấp + (Đơn giá giờ × 1.5 × Giờ tăng ca) + Thưởng/Điều chỉnh − Khấu trừ BHXH. Có thể sửa trực tiếp cột 'Thưởng / Điều chỉnh'."
                                           FontSize="11.5"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding PayrollRows}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode}" IsReadOnly="True" Width="80" />
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding EmployeeName}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="Lương CB" Binding="{Binding BaseSalaryVnd, StringFormat=N0}" IsReadOnly="True" Width="105" />
                                <DataGridTextColumn Header="Phụ cấp" Binding="{Binding AllowanceVnd, StringFormat=N0}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="Công" Binding="{Binding ActualWorkDays, StringFormat=F2}" IsReadOnly="True" Width="60" />
                                <DataGridTextColumn Header="OT (h)" Binding="{Binding OvertimeHours, StringFormat=F1}" IsReadOnly="True" Width="60" />
                                <DataGridTextColumn Header="Lương công" Binding="{Binding ProratedBaseSalaryVnd, StringFormat=N0}" IsReadOnly="True" Width="105" />
                                <DataGridTextColumn Header="Lương OT" Binding="{Binding OvertimePayVnd, StringFormat=N0}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="Thưởng / ĐC" Binding="{Binding BonusOrAdjustmentVnd, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="BHXH" Binding="{Binding InsuranceDeductionVnd, StringFormat=N0}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="Thực lĩnh (VNĐ)" Binding="{Binding NetSalaryVnd, StringFormat=N0}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
