<controls:EzFluentWindow x:Class="EzCompany.App.Views.DetachedChatWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                         xmlns:controls="clr-namespace:EzCompany.App.Controls"
                         Title="Ez Company — Chat nội bộ (Cửa sổ riêng)"
                         Icon="pack://application:,,,/Assets/EzCompany.ico"
                         FontSize="{DynamicResource AppFontSize}"
                         Width="1000"
                         Height="700"
                         MinWidth="760"
                         MinHeight="520"
                         WindowStartupLocation="CenterScreen"
                         ExtendsContentIntoTitleBar="True"
                         WindowBackdropType="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Ez Company — Chat nội bộ (Kéo thả vào cửa sổ chính để tự động gắn lại)">
            <ui:TitleBar.TrailingContent>
                <ui:Button Appearance="Secondary"
                           Content="↙ Gắn về cửa sổ chính"
                           Click="RedockButton_Click"
                           Margin="0,0,8,0" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ContentControl x:Name="ChatHost" Grid.Row="1" />
    </Grid>
</controls:EzFluentWindow>
