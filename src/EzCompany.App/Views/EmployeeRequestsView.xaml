<UserControl x:Class="EzCompany.App.Views.EmployeeRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Đơn từ nội bộ — Xin Nghỉ phép, Đi muộn, Tăng ca &amp; Tạm ứng" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusBanner}" Opacity="0.82" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Đồng bộ LAN" Command="{Binding SyncNowCommand}" />
            <ui:Button Grid.Column="3" Appearance="Primary" Content="Làm mới" Command="{Binding RefreshAllCommand}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="1. Đơn Xin Nghỉ phép / Đi muộn / Tăng ca (Tự động vào Chấm công)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="{DynamicResource AppCardPadding}"
                            CornerRadius="{DynamicResource AppCardCornerRadius}"
                            Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppCardBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Loại đơn" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding LeaveTypes}" SelectedItem="{Binding LeaveType}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Từ ngày" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding LeaveStartDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Đến ngày" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding LeaveEndDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Số giờ OT (nếu OT)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding LeaveOvertimeHours, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Lý do" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập lý do chi tiết..." />
                                        <ui:Button Grid.Column="2" Appearance="Primary" Content="Gửi đơn" Command="{Binding SubmitLeaveRequestCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding MyLeaveRequests}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại đơn" Binding="{Binding RequestType}" Width="95" />
                            <DataGridTextColumn Header="Từ ngày" Binding="{Binding StartDateKey}" Width="100" />
                            <DataGridTextColumn Header="Đến ngày" Binding="{Binding EndDateKey}" Width="100" />
                            <DataGridTextColumn Header="OT (h)" Binding="{Binding OvertimeHours, StringFormat=F1}" Width="70" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Người duyệt" Binding="{Binding ReviewedByName}" Width="135" />
                            <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="Ghi chú duyệt" Binding="{Binding ReviewNotes}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="2. Đề xuất Tạm ứng / Hoàn ứng / Thanh toán">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="{DynamicResource AppCardPadding}"
                            CornerRadius="{DynamicResource AppCardCornerRadius}"
                            Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppCardBorderBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ExpenseTypes}" SelectedItem="{Binding ExpenseType}" />
                                <ui:TextBox Grid.Column="2" Text="{Binding ExpenseCategory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Hạng mục chi..." />
                                <ui:TextBox Grid.Column="4" Text="{Binding ExpenseAmountText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Số tiền VNĐ..." />
                                <ui:TextBox Grid.Column="6" Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Diễn giải đề xuất chi phí..." />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:TextBox Text="{Binding ExpenseReceiptPath}" IsReadOnly="True" PlaceholderText="Ảnh chứng từ / hóa đơn (tùy chọn)..." Width="300" Margin="0,0,8,0" />
                                <ui:Button Content="Chọn chứng từ..." Command="{Binding BrowseExpenseReceiptCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Primary" Content="Gửi Đề xuất Chi phí" Command="{Binding SubmitExpenseRequestCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding MyExpenseRequests}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại" Binding="{Binding RequestType}" Width="105" />
                            <DataGridTextColumn Header="Hạng mục" Binding="{Binding Category}" Width="145" />
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountVnd, StringFormat=N0}" Width="120" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Người duyệt" Binding="{Binding ApprovedByName}" Width="135" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Ghi chú duyệt" Binding="{Binding ReviewNotes}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
