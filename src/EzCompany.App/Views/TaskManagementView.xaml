<UserControl x:Class="EzCompany.App.Views.TaskManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="TasksRoot">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource AppCardMaxWidth}" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Giao việc &amp; Nhận bàn giao kết quả (P2P LAN)"
                               FontSize="{DynamicResource AppFontSizeTitle}"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusBanner}"
                               Margin="0,4,0,0"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Content="Đồng bộ LAN ngay"
                           Command="{Binding SyncNowCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Grid.Column="2"
                           Appearance="Primary"
                           Content="Làm mới"
                           Command="{Binding RefreshAllCommand}" />
            </Grid>

            <!-- Create & Assign Task -->
            <Border Padding="{DynamicResource AppCardPadding}"
                    Margin="0,0,0,16"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardInnerBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <StackPanel>
                    <TextBlock Text="Tạo &amp; Giao công việc mới (Giám đốc / Nhân viên giao việc cho nhau)"
                               FontSize="{DynamicResource AppFontSizeHeading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="135" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Người nhận việc" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Role}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tiêu đề công việc" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Nhập tên đầu việc cần giao..." />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Ưu tiên" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding NewTaskPriority}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Hạn hoàn thành" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding NewTaskDueDate}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Giao đồng thời nhiều nhân viên" IsChecked="{Binding AssignToMultiplePeers}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="Lặp lại:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableRecurrences}" SelectedItem="{Binding NewTaskRecurrence}" Width="115" />
                    </WrapPanel>

                    <Border Margin="0,8,0,0"
                            Padding="8"
                            CornerRadius="8"
                            Background="{DynamicResource AppCardBackgroundBrush}"
                            Visibility="{Binding AssignToMultiplePeers, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding SelectableAssignees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,14,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Mô tả chi tiết yêu cầu công việc..." />
                        <ui:TextBox Grid.Column="2"
                                    IsReadOnly="True"
                                    Text="{Binding NewTaskAttachmentPath}"
                                    PlaceholderText="Tệp giao việc (tùy chọn)..." />
                        <ui:Button Grid.Column="4"
                                   Content="Đính kèm..."
                                   Command="{Binding BrowseNewTaskAttachmentCommand}" />
                        <ui:Button Grid.Column="6"
                                   Appearance="Primary"
                                   Content="Giao việc ngay"
                                   Command="{Binding AssignTaskCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search & Filters -->
            <Border Padding="12"
                    Margin="0,0,0,12"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Tìm việc:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <ui:TextBox Text="{Binding TaskSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Tìm theo tiêu đề, người giao, người nhận..."
                                Width="280"
                                Margin="0,0,12,0" />
                    <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding TaskStatusFilter}"
                              Width="145"
                              Margin="0,0,12,0" />
                    <TextBlock Text="Ưu tiên:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding PriorityFilterOptions}"
                              SelectedItem="{Binding TaskPriorityFilter}"
                              Width="115" />
                </WrapPanel>
            </Border>

            <!-- Tabs: Inbox, Outbox, History -->
            <TabControl>
                <TabItem Header="Việc tôi được giao &amp; Bàn giao kết quả">
                    <StackPanel Margin="0,12,0,0">
                        <DataGrid ItemsSource="{Binding FilteredInboxTasks}"
                                  SelectedItem="{Binding SelectedInboxTask}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="210"
                                  Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Người giao" Binding="{Binding AssignerFullName}" Width="125" />
                                <DataGridTextColumn Header="Ưu tiên" Binding="{Binding Priority}" Width="75" />
                                <DataGridTextColumn Header="Lặp" Binding="{Binding RecurrenceRule}" Width="65" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="105" />
                                <DataGridTextColumn Header="Tệp giao việc" Binding="{Binding AssignmentFileName}" Width="120" />
                                <DataGridTextColumn Header="Ghi chú nghiệm thu" Binding="{Binding ReviewNotes}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Subtasks Checklist -->
                        <Border Padding="{DynamicResource AppCardPadding}"
                                Margin="0,0,0,12"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Checklist công việc con (Subtasks)" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Thêm đầu việc con cần thực hiện..."
                                                Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1"
                                               Appearance="Secondary"
                                               Content="Thêm mục"
                                               Command="{Binding AddSubtaskCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding InboxSubtasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Content="{Binding Title}"
                                                          IsChecked="{Binding IsDone, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />
                                                <ui:Button Grid.Column="1"
                                                           Appearance="Secondary"
                                                           Padding="6,2"
                                                           Content="✕"
                                                           Command="{Binding DataContext.DeleteSubtaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Padding="{DynamicResource AppCardPadding}"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Gửi bàn giao kết quả cho công việc đang chọn" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ui:TextBox Text="{Binding HandoverNotes, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Nhập báo cáo / kết quả bàn giao..."
                                            Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                IsReadOnly="True"
                                                Text="{Binding HandoverAttachmentPath}"
                                                PlaceholderText="Tệp kết quả đính kèm (tùy chọn, tối đa 10 MB)..." />
                                    <ui:Button Grid.Column="2" Content="Chọn tệp..." Command="{Binding BrowseHandoverAttachmentCommand}" />
                                </Grid>
                                <WrapPanel>
                                    <ui:Button Content="Mở tệp giao việc" Command="{Binding OpenSelectedInboxAssignmentAttachmentCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="Bắt đầu thực hiện" Command="{Binding StartInboxTaskCommand}" Margin="0,0,8,0" />
                                    <ui:Button Appearance="Primary" Content="Gửi bàn giao kết quả" Command="{Binding SubmitHandoverCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Việc tôi đã giao &amp; Nghiệm thu">
                    <StackPanel Margin="0,12,0,0">
                        <DataGrid ItemsSource="{Binding FilteredOutboxTasks}"
                                  SelectedItem="{Binding SelectedOutboxTask}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="210"
                                  Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Người nhận" Binding="{Binding AssigneeFullName}" Width="140" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115" />
                                <DataGridTextColumn Header="Kết quả bàn giao" Binding="{Binding HandoverNotes}" Width="180" />
                                <DataGridTextColumn Header="Tệp" Binding="{Binding HandoverFileName}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="{DynamicResource AppCardPadding}"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppCardBorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Nghiệm thu / Yêu cầu chỉnh sửa kết quả bàn giao" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ui:TextBox Text="{Binding ReviewNotes, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Nhận xét nghiệm thu hoặc lý do yêu cầu làm lại..."
                                            Margin="0,0,0,10" />
                                <WrapPanel>
                                    <ui:Button Content="Mở tệp bàn giao" Command="{Binding OpenSelectedOutboxAttachmentCommand}" Margin="0,0,8,0" />
                                    <ui:Button Appearance="Primary" Content="Xác nhận hoàn thành" Command="{Binding ApproveOutboxHandoverCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="Yêu cầu làm lại" Command="{Binding RequestOutboxRevisionCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Lịch sử giao việc &amp; bàn giao">
                    <DataGrid ItemsSource="{Binding TaskHistories}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,12,0,0"
                              MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian (UTC)" Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="135" />
                            <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="125" />
                            <DataGridTextColumn Header="Người thực hiện" Binding="{Binding ActorFullName}" Width="145" />
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*" />
                            <DataGridTextColumn Header="Tệp" Binding="{Binding AttachmentFileName}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
