<UserControl x:Class="EzCompany.App.Views.ExecutiveDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="ExecRoot">
    <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bảng tổng quan Điều hành (Executive Dashboard)"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusBanner}"
                               Margin="0,4,0,0"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Content="Đồng bộ &amp; Làm mới LAN"
                           Command="{Binding RefreshAllCommand}" />
            </Grid>

            <!-- 1. KPI Summary Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Padding="{DynamicResource AppCardPadding}" Margin="0,0,8,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Máy Online / Tổng" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiOnlineText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="{DynamicResource AppCardPadding}" Margin="4,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Tổng giờ Active hôm nay" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiActiveHoursText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="{DynamicResource AppCardPadding}" Margin="4,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Dung lượng DB + Vault LAN" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiStorageText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="{DynamicResource AppCardPadding}" Margin="8,0,0,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}" ToolTip="{Binding KpiAlertDetails}">
                    <StackPanel>
                        <TextBlock Text="Cảnh báo đỏ (24h)" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiRedAlertsText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding KpiAlertDetails}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 1B. Approval Hub (Unified Pending Leave & Expense Approvals) -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,0,0,16" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Trung tâm Phê duyệt tập trung (Approval Hub)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ApprovalHubSummaryText}" FontSize="12" Opacity="0.75" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Content="Làm mới phê duyệt" Command="{Binding RefreshApprovalHubCommand}" />
                    </Grid>

                    <ui:TextBox Text="{Binding ApprovalReviewNotes, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Ghi chú duyệt hoặc lý do từ chối (dùng chung cho đơn đang chọn)..."
                                Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Leave / Overtime Pending -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Đơn Nghỉ phép / Tăng ca chờ duyệt" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding PendingLeaveRequests}"
                                      SelectedItem="{Binding SelectedPendingLeave}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MaxHeight="170"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeName}" Width="120" />
                                    <DataGridTextColumn Header="Loại" Binding="{Binding RequestType}" Width="75" />
                                    <DataGridTextColumn Header="Từ ngày" Binding="{Binding StartDateKey}" Width="88" />
                                    <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <ui:Button Appearance="Primary" Content="Duyệt đơn phép/OT" Command="{Binding ApproveSelectedLeaveCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Content="Từ chối" Command="{Binding RejectSelectedLeaveCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Expense Requests Pending -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đề xuất Tạm ứng / Thanh toán chờ duyệt" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding PendingExpenseRequests}"
                                      SelectedItem="{Binding SelectedPendingExpense}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MaxHeight="170"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Người đề xuất" Binding="{Binding RequesterFullName}" Width="120" />
                                    <DataGridTextColumn Header="Loại" Binding="{Binding RequestType}" Width="90" />
                                    <DataGridTextColumn Header="Số tiền (đ)" Binding="{Binding AmountVnd, StringFormat=N0}" Width="95" />
                                    <DataGridTextColumn Header="Nội dung" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <ui:Button Appearance="Primary" Content="Duyệt chi phí" Command="{Binding ApproveSelectedExpenseCommand}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Content="Từ chối" Command="{Binding RejectSelectedExpenseCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 1C. Visual KPI Charts -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,0,0,16" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Biểu đồ KPI Trực quan (Tháng hiện tại)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tỷ lệ hoàn thành công việc theo nhân sự" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding EmployeeTaskCharts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Opacity="0.78" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border Height="8" CornerRadius="4" Background="#22888888" Margin="0,3,0,0" HorizontalAlignment="Left" Width="220">
                                                <Border Height="8" CornerRadius="4" Background="{DynamicResource AppAccentBrush}" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tổng giờ làm việc &amp; Đi muộn trong tháng" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding EmployeeAttendanceCharts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Opacity="0.78" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border Height="8" CornerRadius="4" Background="#22888888" Margin="0,3,0,0" HorizontalAlignment="Left" Width="220">
                                                <Border Height="8" CornerRadius="4" Background="#16A34A" Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. LAN Workstations Expandable List + Per-Device Details & Policy -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,0,0,16" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="2. Danh sách Máy trạm LAN &amp; Phân quyền" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Bấm vào từng máy để xem chi tiết và thiết lập phân quyền" FontSize="12" Opacity="0.72" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="2"
                                    Text="{Binding WorkstationSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Tìm theo tên, username, chức vụ..."
                                    VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WorkstationCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="{DynamicResource AppCardCornerRadius}"
                                        Background="{DynamicResource AppCardInnerBackgroundBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AppCardBorderBrush}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <Expander.Header>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="#22C55E"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="#EF4444"
                                                         Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Username, StringFormat='@{0}'}" Opacity="0.78" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding RoleBilingual}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Padding="8,2" CornerRadius="6" Background="{DynamicResource AppCardBackgroundBrush}" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding OnlineText}" FontSize="11.5" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Padding="8,2" CornerRadius="6" Background="{DynamicResource AppCardBackgroundBrush}">
                                                        <TextBlock Text="{Binding AppVersionText}" FontSize="11.5" Opacity="0.85" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>

                                        <Border Margin="0,8,0,2"
                                                Padding="12"
                                                CornerRadius="8"
                                                Background="{DynamicResource AppCardBackgroundBrush}">
                                            <StackPanel>
                                                <!-- Device Technical Details -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding MachineId, StringFormat='MachineId: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding EndpointText, StringFormat='Địa chỉ LAN: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding LastSeenText, StringFormat='Hoạt động cuối: {0}'}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding PolicyVersionText, StringFormat='Phiên bản Policy: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding AppVersionText, StringFormat='Phiên bản App: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding FreeDiskText, StringFormat='Ổ cứng trống: {0}'}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="{Binding StorageText, StringFormat='Dung lượng: {0}'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding LastBackupText, StringFormat='Sao lưu cuối: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding PairedText, StringFormat='Ghép đôi: {0}'}" FontSize="12" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding PendingPolicyText}" FontSize="11.5" Opacity="0.78" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <Separator Margin="0,10,0,10" Opacity="0.25" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Policy + Notice -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Phân quyền (Hỗ trợ nhiều chức vụ cùng lúc)" FontWeight="SemiBold" />
                                                        <WrapPanel Margin="0,6,0,4">
                                                            <CheckBox Content="Manager (Giám đốc)" IsChecked="{Binding DataContext.EditRoleDirector, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,4" />
                                                            <CheckBox Content="Accounting (Kế toán)" IsChecked="{Binding DataContext.EditRoleAccounting, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,4" />
                                                            <CheckBox Content="Legal (Pháp chế)" IsChecked="{Binding DataContext.EditRoleLegal, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,4" />
                                                            <CheckBox Content="HR (Nhân sự)" IsChecked="{Binding DataContext.EditRoleHr, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,4" />
                                                            <CheckBox Content="Staff (Nhân viên)" IsChecked="{Binding DataContext.EditRoleStaff, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,4" />
                                                        </WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                                            <CheckBox Content="Module Kế toán XML" IsChecked="{Binding DataContext.EditAllowAccounting, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,0" />
                                                            <CheckBox Content="Module Pháp chế Diff" IsChecked="{Binding DataContext.EditAllowLegal, ElementName=ExecRoot, Mode=TwoWay}" Margin="0,0,8,0" />
                                                            <CheckBox Content="Module Văn phòng PDF" IsChecked="{Binding DataContext.EditAllowOffice, ElementName=ExecRoot, Mode=TwoWay}" />
                                                        </StackPanel>
                                                        <WrapPanel>
                                                            <ui:Button Appearance="Primary" Content="Cập nhật Phân quyền" Command="{Binding DataContext.ApplyPolicyToSelectedWorkstationCommand, ElementName=ExecRoot}" Margin="0,0,8,6" />
                                                            <ui:Button Content="Sao chép DB (VACUUM INTO)" Command="{Binding DataContext.BackupSelectedDatabaseCommand, ElementName=ExecRoot}" Margin="0,0,8,6" />
                                                            <ui:Button Content="Mở DB Inspector" Command="{Binding DataContext.OpenLastBackupInInspectorCommand, ElementName=ExecRoot}" Margin="0,0,8,6" />
                                                        </WrapPanel>

                                                        <TextBlock Text="Gửi thông báo LAN" FontWeight="SemiBold" Margin="0,8,0,4" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBox Grid.Column="0"
                                                                        Text="{Binding DataContext.NoticeMessage, ElementName=ExecRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        PlaceholderText="Nhập nội dung gửi máy đang chọn..." />
                                                            <ui:Button Grid.Column="2" Content="Gửi thông báo" Command="{Binding DataContext.SendNoticeToSelectedCommand, ElementName=ExecRoot}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Vault Browser -->
                                                    <StackPanel Grid.Column="2">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="Duyệt &amp; Tải Vault" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <ui:Button Content="Tải cây Vault" Command="{Binding DataContext.LoadSelectedVaultTreeCommand, ElementName=ExecRoot}" Margin="0,0,8,0" />
                                                            <ui:Button Content="Tải tệp đã chọn" Command="{Binding DataContext.DownloadSelectedVaultFileCommand, ElementName=ExecRoot}" />
                                                        </StackPanel>
                                                        <ListBox ItemsSource="{Binding DataContext.SelectedVaultFiles, ElementName=ExecRoot}"
                                                                 SelectedItem="{Binding DataContext.SelectedVaultFile, ElementName=ExecRoot, Mode=TwoWay}"
                                                                 Height="115">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding RelativePath}" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Audit Logs & App Usage -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="{DynamicResource AppCardPadding}" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="3a. Nhật ký AuditLogs" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentAuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="85" />
                                <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="140" />
                                <DataGridTextColumn Header="Chi tiết" Binding="{Binding TargetEntity}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="{DynamicResource AppCardPadding}" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="3b. Thời lượng ứng dụng (Đã lọc riêng tư)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding TopAppUsages}" AutoGenerateColumns="False" IsReadOnly="True" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="80" />
                                <DataGridTextColumn Header="App" Binding="{Binding ProcessName}" Width="100" />
                                <DataGridTextColumn Header="Giây" Binding="{Binding ActiveSeconds}" Width="60" />
                                <DataGridTextColumn Header="Tiêu đề cửa sổ" Binding="{Binding SanitizedWindowTitle}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Encrypted Snapshot Timeline (Director Cache) -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,0,0,16" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="4. Dòng thời gian Ảnh chụp giải mã từ Director Cache (Xem lại cả khi nhân viên tắt máy)"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Chọn ảnh ở danh sách bên trái • Nhấp đúp để phóng to"
                                       FontSize="12"
                                       Opacity="0.72"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Content="Tải &amp; Giải mã ảnh rõ nét 1280px" Command="{Binding ViewFullSnapshotCommand}" Margin="0,0,6,0" />
                            <ui:Button Appearance="Primary" Content="🔍 Phóng to / Xem ảnh" Command="{Binding OpenSnapshotViewerCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Mở bằng ứng dụng xem ảnh" Command="{Binding OpenSnapshotExternallyCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Lưu ảnh..." Command="{Binding SaveSnapshotAsCommand}" />
                        </WrapPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding SnapshotTimeline}"
                                 SelectedItem="{Binding SelectedSnapshot}"
                                 MouseDoubleClick="SnapshotList_MouseDoubleClick"
                                 Height="210">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <Image Source="{Binding ThumbnailImage}" Width="80" Height="50" Margin="0,0,8,0" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Background="#22000000"
                                Height="210"
                                Cursor="Hand"
                                ToolTip="Nhấp đúp để phóng to"
                                MouseLeftButtonDown="SnapshotPreview_MouseLeftButtonDown">
                            <Image Source="{Binding FullPreviewImage}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. SAS Pairing Approval & Release Governance Center -->
            <Border Padding="{DynamicResource AppCardPadding}" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="5. Trung tâm duyệt ghép đôi SAS 6 số" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Appearance="Primary" Content="{Binding PairingToggleText}" Command="{Binding TogglePairingWindowCommand}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding PairingCountdownText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding PendingPairings}" SelectedItem="{Binding SelectedPairingRequest}" Height="110" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding SasCode}" FontWeight="Bold" FontSize="16" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding FullName}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Username}" Opacity="0.7" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="Manager (Giám đốc)" IsChecked="{Binding ApproveRoleDirector}" Margin="0,0,8,4" />
                            <CheckBox Content="Accounting (Kế toán)" IsChecked="{Binding ApproveRoleAccounting}" Margin="0,0,8,4" />
                            <CheckBox Content="Legal (Pháp chế)" IsChecked="{Binding ApproveRoleLegal}" Margin="0,0,8,4" />
                            <CheckBox Content="HR (Nhân sự)" IsChecked="{Binding ApproveRoleHr}" Margin="0,0,8,4" />
                            <CheckBox Content="Staff (Nhân viên)" IsChecked="{Binding ApproveRoleStaff}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="Kế toán" IsChecked="{Binding ApproveAccounting}" Margin="0,0,8,6" />
                            <CheckBox Content="Pháp chế" IsChecked="{Binding ApproveLegal}" Margin="0,0,8,6" />
                            <CheckBox Content="Văn phòng" IsChecked="{Binding ApproveOffice}" Margin="0,0,12,6" />
                            <ui:Button Appearance="Primary" Content="Duyệt ghép đôi" Command="{Binding ApproveSelectedPairingCommand}" Margin="0,0,8,6" />
                            <ui:Button Content="Từ chối" Command="{Binding RejectSelectedPairingCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Quản trị Phát hành (MaxApprovedVersion)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Phiên bản tối đa cho nhân viên (SemVer)" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding FleetMaxApprovedVersion, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="vd: 0.1.0" Margin="0,0,0,8" />
                        <TextBlock Text="Kênh cập nhật cho phép" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableChannels}" SelectedItem="{Binding FleetAllowedChannel}" Margin="0,0,0,10" />
                        <ui:Button Appearance="Primary" Content="Áp dụng giới hạn cập nhật" Command="{Binding ApplyReleaseGovernanceFleetWideCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Employee Password / Account Reset Requests -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,16,0,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="6. Yêu cầu cấp lại tài khoản / mật khẩu từ Nhân viên"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <ui:Button Grid.Column="1"
                                   Content="Làm mới yêu cầu"
                                   Command="{Binding RefreshPendingPasswordResetsCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding PendingPasswordResets}"
                              SelectedItem="{Binding SelectedPasswordReset}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="150"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding FullName}" Width="140" />
                            <DataGridTextColumn Header="User hiện tại" Binding="{Binding Username}" Width="110" />
                            <DataGridTextColumn Header="User mới đề xuất" Binding="{Binding RequestedNewUsername}" Width="120" />
                            <DataGridTextColumn Header="MachineId" Binding="{Binding MachineId}" Width="140" />
                            <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <ui:Button Appearance="Primary"
                                   Content="Duyệt cấp lại mật khẩu (Ký số Ed25519)"
                                   Command="{Binding ApproveSelectedPasswordResetCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Từ chối yêu cầu"
                                   Command="{Binding RejectSelectedPasswordResetCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 7. Scheduled Auto-Backup (Director Auto-Backup) -->
            <Border Padding="{DynamicResource AppCardPadding}" Margin="0,16,0,0" CornerRadius="{DynamicResource AppCardCornerRadius}" Background="{DynamicResource AppCardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="7. Tự động Sao lưu định kỳ dữ liệu Nhân viên (Director Auto-Backup)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <CheckBox Content="Bật sao lưu tự động định kỳ"
                                  IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                  Margin="0,0,14,4" />
                        <TextBlock Text="Chu kỳ (giờ):" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ui:TextBox Text="{Binding AutoBackupIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                    Width="75"
                                    Margin="0,0,14,4" />
                        <TextBlock Text="Giữ lại tối đa (bản/máy):" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ui:TextBox Text="{Binding AutoBackupRetentionCount, UpdateSourceTrigger=PropertyChanged}"
                                    Width="75"
                                    Margin="0,0,14,4" />
                        <ui:Button Appearance="Secondary"
                                   Content="Lưu lịch sao lưu"
                                   Command="{Binding SaveAutoBackupConfigCommand}"
                                   Margin="0,0,8,4" />
                        <ui:Button Appearance="Primary"
                                   Content="Sao lưu toàn bộ máy Online ngay"
                                   Command="{Binding RunAutoBackupNowCommand}"
                                   Margin="0,0,0,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AutoBackupLastSummary}"
                               Opacity="0.82"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
