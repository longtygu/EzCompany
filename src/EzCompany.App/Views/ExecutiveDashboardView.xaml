<UserControl x:Class="EzCompany.App.Views.ExecutiveDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bảng tổng quan Điều hành (Executive Dashboard)"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusBanner}"
                               Margin="0,4,0,0"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Content="Đồng bộ &amp; Làm mới LAN"
                           Command="{Binding RefreshAllCommand}" />
            </Grid>

            <!-- 1. KPI Summary Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Padding="14" Margin="0,0,8,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Máy Online / Tổng" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiOnlineText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="4,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Tổng giờ Active hôm nay" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiActiveHoursText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="4,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Dung lượng DB + Vault LAN" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiStorageText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" ToolTip="{Binding KpiAlertDetails}">
                    <StackPanel>
                        <TextBlock Text="Cảnh báo đỏ (24h)" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding KpiRedAlertsText}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding KpiAlertDetails}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 2. LAN Workstations Grid + 1-Click Actions -->
            <Border Padding="14" Margin="0,0,0,16" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="2. Lưới Máy trạm LAN &amp; Thao tác 1-Click" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Workstations}"
                              SelectedItem="{Binding SelectedWorkstation}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding FullName}" Width="140" />
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="100" />
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="90" />
                            <DataGridCheckBoxColumn Header="Online" Binding="{Binding IsOnline}" Width="60" />
                            <DataGridTextColumn Header="Policy v" Binding="{Binding CurrentPolicyVersion}" Width="70" />
                            <DataGridTextColumn Header="App" Binding="{Binding AppVersion}" Width="70" />
                            <DataGridTextColumn Header="Ổ trống (%)" Binding="{Binding FreeDiskPercent, StringFormat=F1}" Width="85" />
                            <DataGridTextColumn Header="MachineId" Binding="{Binding MachineId}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Policy + Notice -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phân quyền (Hỗ trợ nhiều chức vụ cùng lúc)" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,6,0,4">
                                <CheckBox Content="Manager (Giám đốc)" IsChecked="{Binding EditRoleDirector}" Margin="0,0,8,4" />
                                <CheckBox Content="Accounting (Kế toán)" IsChecked="{Binding EditRoleAccounting}" Margin="0,0,8,4" />
                                <CheckBox Content="Legal (Pháp chế)" IsChecked="{Binding EditRoleLegal}" Margin="0,0,8,4" />
                                <CheckBox Content="HR (Nhân sự)" IsChecked="{Binding EditRoleHr}" Margin="0,0,8,4" />
                                <CheckBox Content="Staff (Nhân viên)" IsChecked="{Binding EditRoleStaff}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                <CheckBox Content="Module Kế toán XML" IsChecked="{Binding EditAllowAccounting}" Margin="0,0,8,0" />
                                <CheckBox Content="Module Pháp chế Diff" IsChecked="{Binding EditAllowLegal}" Margin="0,0,8,0" />
                                <CheckBox Content="Module Văn phòng PDF" IsChecked="{Binding EditAllowOffice}" />
                            </StackPanel>
                            <WrapPanel>
                                <ui:Button Appearance="Primary" Content="Cập nhật Phân quyền" Command="{Binding ApplyPolicyToSelectedWorkstationCommand}" Margin="0,0,8,6" />
                                <ui:Button Content="Sao chép DB (VACUUM INTO)" Command="{Binding BackupSelectedDatabaseCommand}" Margin="0,0,8,6" />
                                <ui:Button Content="Mở DB Inspector" Command="{Binding OpenLastBackupInInspectorCommand}" Margin="0,0,8,6" />
                            </WrapPanel>

                            <TextBlock Text="Gửi thông báo LAN" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding NoticeMessage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập nội dung gửi máy đang chọn..." />
                                <ui:Button Grid.Column="2" Content="Gửi thông báo" Command="{Binding SendNoticeToSelectedCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Vault Browser -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Duyệt &amp; Tải Vault" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ui:Button Content="Tải cây Vault" Command="{Binding LoadSelectedVaultTreeCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Tải tệp đã chọn" Command="{Binding DownloadSelectedVaultFileCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding SelectedVaultFiles}" SelectedItem="{Binding SelectedVaultFile}" Height="115">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativePath}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Audit Logs & App Usage -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="3a. Nhật ký AuditLogs" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentAuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="85" />
                                <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="140" />
                                <DataGridTextColumn Header="Chi tiết" Binding="{Binding TargetEntity}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="3b. Thời lượng ứng dụng (Đã lọc riêng tư)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding TopAppUsages}" AutoGenerateColumns="False" IsReadOnly="True" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="80" />
                                <DataGridTextColumn Header="App" Binding="{Binding ProcessName}" Width="100" />
                                <DataGridTextColumn Header="Giây" Binding="{Binding ActiveSeconds}" Width="60" />
                                <DataGridTextColumn Header="Tiêu đề cửa sổ" Binding="{Binding SanitizedWindowTitle}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Encrypted Snapshot Timeline (Director Cache) -->
            <Border Padding="14" Margin="0,0,0,16" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="4. Dòng thời gian Ảnh chụp giải mã từ Director Cache (Xem lại cả khi nhân viên tắt máy)"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <ui:Button Grid.Column="1" Content="Tải &amp; Giải mã ảnh rõ nét 1280px" Command="{Binding ViewFullSnapshotCommand}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding SnapshotTimeline}"
                                 SelectedItem="{Binding SelectedSnapshot}"
                                 Height="210">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <Image Source="{Binding ThumbnailImage}" Width="80" Height="50" Margin="0,0,8,0" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" CornerRadius="8" Background="#22000000" Height="210">
                            <Image Source="{Binding FullPreviewImage}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. SAS Pairing Approval & Release Governance Center -->
            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="5. Trung tâm duyệt ghép đôi SAS 6 số" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Appearance="Primary" Content="{Binding PairingToggleText}" Command="{Binding TogglePairingWindowCommand}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding PairingCountdownText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding PendingPairings}" SelectedItem="{Binding SelectedPairingRequest}" Height="110" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding SasCode}" FontWeight="Bold" FontSize="16" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding FullName}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Username}" Opacity="0.7" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="Manager (Giám đốc)" IsChecked="{Binding ApproveRoleDirector}" Margin="0,0,8,4" />
                            <CheckBox Content="Accounting (Kế toán)" IsChecked="{Binding ApproveRoleAccounting}" Margin="0,0,8,4" />
                            <CheckBox Content="Legal (Pháp chế)" IsChecked="{Binding ApproveRoleLegal}" Margin="0,0,8,4" />
                            <CheckBox Content="HR (Nhân sự)" IsChecked="{Binding ApproveRoleHr}" Margin="0,0,8,4" />
                            <CheckBox Content="Staff (Nhân viên)" IsChecked="{Binding ApproveRoleStaff}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="Kế toán" IsChecked="{Binding ApproveAccounting}" Margin="0,0,8,6" />
                            <CheckBox Content="Pháp chế" IsChecked="{Binding ApproveLegal}" Margin="0,0,8,6" />
                            <CheckBox Content="Văn phòng" IsChecked="{Binding ApproveOffice}" Margin="0,0,12,6" />
                            <ui:Button Appearance="Primary" Content="Duyệt ghép đôi" Command="{Binding ApproveSelectedPairingCommand}" Margin="0,0,8,6" />
                            <ui:Button Content="Từ chối" Command="{Binding RejectSelectedPairingCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Quản trị Phát hành (MaxApprovedVersion)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Phiên bản tối đa cho nhân viên (SemVer)" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding FleetMaxApprovedVersion, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="vd: 0.1.0" Margin="0,0,0,8" />
                        <TextBlock Text="Kênh cập nhật cho phép" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableChannels}" SelectedItem="{Binding FleetAllowedChannel}" Margin="0,0,0,10" />
                        <ui:Button Appearance="Primary" Content="Áp dụng giới hạn cập nhật" Command="{Binding ApplyReleaseGovernanceFleetWideCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Employee Password / Account Reset Requests -->
            <Border Padding="14" Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="6. Yêu cầu cấp lại tài khoản / mật khẩu từ Nhân viên"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <ui:Button Grid.Column="1"
                                   Content="Làm mới yêu cầu"
                                   Command="{Binding RefreshPendingPasswordResetsCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding PendingPasswordResets}"
                              SelectedItem="{Binding SelectedPasswordReset}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="150"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding FullName}" Width="140" />
                            <DataGridTextColumn Header="User hiện tại" Binding="{Binding Username}" Width="110" />
                            <DataGridTextColumn Header="User mới đề xuất" Binding="{Binding RequestedNewUsername}" Width="120" />
                            <DataGridTextColumn Header="MachineId" Binding="{Binding MachineId}" Width="140" />
                            <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <ui:Button Appearance="Primary"
                                   Content="Duyệt cấp lại mật khẩu (Ký số Ed25519)"
                                   Command="{Binding ApproveSelectedPasswordResetCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Từ chối yêu cầu"
                                   Command="{Binding RejectSelectedPasswordResetCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
