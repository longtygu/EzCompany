<controls:EzFluentWindow x:Class="EzCompany.App.Views.SnapshotViewerWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                         xmlns:controls="clr-namespace:EzCompany.App.Controls"
                         Title="Xem ảnh chụp màn hình"
                         Icon="pack://application:,,,/Assets/EzCompany.ico"
                         FontSize="{DynamicResource AppFontSize}"
                         Width="1100"
                         Height="760"
                         MinWidth="760"
                         MinHeight="520"
                         WindowStartupLocation="CenterOwner"
                         ExtendsContentIntoTitleBar="True"
                         WindowBackdropType="None"
                         KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Xem ảnh chụp màn hình (Director Cache)" />

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Margin="14,6,14,10"
                Padding="10,8"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppCardBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <ui:Button Padding="8,5" Command="{Binding PreviousCommand}" ToolTip="Ảnh trước (←)" Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                    </ui:Button>
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0" />
                    <ui:Button Padding="8,5" Command="{Binding NextCommand}" ToolTip="Ảnh sau (→)" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                    </ui:Button>

                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,14,0" />

                    <ui:Button Padding="8,5" Command="{Binding ZoomOutCommand}" ToolTip="Thu nhỏ (-)" Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="16" />
                    </ui:Button>
                    <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="46" TextAlignment="Center" Margin="2,0" />
                    <ui:Button Padding="8,5" Command="{Binding ZoomInCommand}" ToolTip="Phóng to (+)" Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" />
                    </ui:Button>
                    <ui:Button Content="100%" Padding="9,5" Command="{Binding ResetZoomCommand}" ToolTip="Kích thước gốc (0)" Margin="0,0,6,0" />
                    <ui:Button Padding="9,5" Command="{Binding FitToWindowCommand}" ToolTip="Vừa khung cửa sổ (F)" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="15" Margin="0,0,5,0" />
                            <TextBlock Text="Vừa khung" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Content="Lưu ảnh..." Padding="10,5" Command="{Binding SaveAsCommand}" Margin="0,0,6,0" />
                    <ui:Button Appearance="Primary" Content="Mở bằng ứng dụng xem ảnh" Padding="10,5" Command="{Binding OpenExternalCommand}" />
                </WrapPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           FontSize="{DynamicResource AppFontSizeSmall}"
                           Opacity="0.78"
                           Margin="0,6,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" />
            </Grid>
        </Border>

        <!-- Zoom & Pan Image Surface -->
        <Border Grid.Row="2"
                Margin="14,0,14,14"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="#22000000"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppCardBorderBrush}">
            <ScrollViewer x:Name="ImageScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScroller_PreviewMouseWheel">
                <Image x:Name="ViewerImage"
                       Source="{Binding CurrentImage}"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Cursor="SizeAll"
                       MouseLeftButtonDown="ViewerImage_MouseLeftButtonDown"
                       MouseMove="ViewerImage_MouseMove"
                       MouseLeftButtonUp="ViewerImage_MouseLeftButtonUp">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </Grid>
</controls:EzFluentWindow>
