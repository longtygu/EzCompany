<controls:EzFluentWindow x:Class="EzCompany.App.Views.TimelineEditorWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                         xmlns:controls="clr-namespace:EzCompany.App.Controls"
                         Title="Ez Company — Tạo &amp; Quản lý Kế hoạch / Lịch trình chung"
                         Icon="pack://application:,,,/Assets/EzCompany.ico"
                         FontSize="{DynamicResource AppFontSize}"
                         Width="920"
                         Height="680"
                         MinWidth="760"
                         MinHeight="560"
                         WindowStartupLocation="CenterOwner"
                         ExtendsContentIntoTitleBar="True"
                         WindowBackdropType="None"
                         x:Name="EditorWinRoot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tạo &amp; Quản lý Lịch trình / Kế hoạch chung" />

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Create / Edit Form Card -->
            <Border Grid.Row="0"
                    Padding="{DynamicResource AppCardPadding}"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EditorTitle}" FontSize="{DynamicResource AppFontSizeHeading}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                        <ui:Button Grid.Column="1" Content="+ Tạo mục mới" Command="{Binding StartNewPlanCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="125" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tiêu đề kế hoạch / sự kiện (*)" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập tên kế hoạch, mốc deadline hoặc cuộc họp..." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Danh mục" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding Category}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Trạng thái" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding Status}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Từ ngày" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding StartDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đến ngày" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Mô tả chi tiết" FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nội dung công việc, người phụ trách..." />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusBanner}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   Visibility="{Binding StatusBanner, Converter={StaticResource NotEmptyToVis}}" />
                        <WrapPanel Grid.Column="1">
                            <ui:Button Content="Chuyển trạng thái" Command="{Binding CycleStatusCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Xóa kế hoạch" Command="{Binding DeletePlanCommand}" Margin="0,0,8,0" />
                            <ui:Button Appearance="Primary" Content="Lưu Lịch trình / Kế hoạch" Command="{Binding SavePlanCommand}" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Existing Plans List -->
            <Border Grid.Row="2"
                    Padding="{DynamicResource AppCardPadding}"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Danh sách Lịch trình &amp; Kế hoạch chung (Bấm vào 1 mục để chỉnh sửa)"
                               FontSize="{DynamicResource AppFontSizeHeading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Plans}"
                              SelectedItem="{Binding SelectedPlan}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="95" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDateUtc, StringFormat=dd/MM/yyyy}" Width="95" />
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDateUtc, StringFormat=dd/MM/yyyy}" Width="95" />
                            <DataGridTextColumn Header="Người tạo" Binding="{Binding CreatedByFullName}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</controls:EzFluentWindow>
