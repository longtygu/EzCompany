<ui:FluentWindow x:Class="EzCompany.App.Views.WorkspaceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle}"
                 FontSize="{DynamicResource AppFontSize}"
                 Width="1280"
                 Height="820"
                 MinWidth="1024"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button Appearance="Transparent"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="Chuyển giao diện Sáng / Tối"
                               Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="DarkTheme24" />
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Content="Đăng xuất"
                               Command="{Binding LogoutCommand}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Locked policy warning -->
        <Border Grid.Row="1"
                Margin="16,8,16,0"
                Padding="12,10"
                CornerRadius="8"
                Background="#55B00020"
                Visibility="{Binding IsPolicyLocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PolicyLockReason}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <!-- LAN Internal Notice Banner -->
        <Border Grid.Row="2"
                Margin="16,8,16,0"
                Padding="12,10"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                Visibility="{Binding ActiveNoticeBanner, Converter={StaticResource NotEmptyToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ActiveNoticeBanner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Content="Đóng" Command="{Binding DismissNoticeCommand}" />
            </Grid>
        </Border>

        <!-- Main Split Workspace -->
        <Grid Grid.Row="3" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource AppSidebarWidth}" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="6,4,6,12">
                        <TextBlock Text="{Binding CompanyTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UserSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavItem}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ContentControl Content="{Binding ActiveView}" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
