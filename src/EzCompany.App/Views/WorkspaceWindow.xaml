<controls:EzFluentWindow x:Class="EzCompany.App.Views.WorkspaceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:EzCompany.App.Controls"
                 Title="{Binding WindowTitle}"
                 Icon="pack://application:,,,/Assets/EzCompany.ico"
                 FontSize="{DynamicResource AppFontSize}"
                 Width="1320"
                 Height="840"
                 MinWidth="1040"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button Appearance="Transparent"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="Chuyển giao diện Sáng / Tối"
                               Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="DarkTheme24" />
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Content="Đăng xuất"
                               Command="{Binding LogoutCommand}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Locked policy warning -->
        <Border Grid.Row="1"
                Margin="16,8,16,0"
                Padding="12,10"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="#55B00020"
                Visibility="{Binding IsPolicyLocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PolicyLockReason}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <!-- LAN Internal / Task / Chat Notification Banner -->
        <Border Grid.Row="2"
                Margin="16,8,16,0"
                Padding="12,10"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppAccentBrush}"
                Visibility="{Binding ActiveNoticeBanner, Converter={StaticResource NotEmptyToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ActiveNoticeBanner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Content="Xem ngay"
                           Command="{Binding OpenNoticeTargetCommand}"
                           Visibility="{Binding HasNoticeAction, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,8,0" />
                <ui:Button Grid.Column="2" Content="Đóng" Command="{Binding DismissNoticeCommand}" />
            </Grid>
        </Border>

        <!-- Main Split Workspace -->
        <Grid Grid.Row="3" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource AppSidebarWidth}" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <DockPanel>
                    <!-- Header with Company Logo & Bilingual Role -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,12">
                        <Image Source="{Binding CompanyLogoImage}"
                               Width="38"
                               Height="38"
                               Stretch="Uniform"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompanyTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="175" />
                            <TextBlock Text="{Binding UserSubtitle}" FontSize="{DynamicResource AppFontSizeSmall}" Opacity="0.78" TextWrapping="Wrap" MaxWidth="175" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Pinned Bottom Unified Settings Button -->
                    <Border DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Padding="0,8,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource AppCardBorderBrush}">
                        <ui:Button HorizontalAlignment="Stretch"
                                   Appearance="Secondary"
                                   Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock Text="Cài đặt" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Giao diện, Tài khoản, Cập nhật, Báo lỗi" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Button>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NavGroupsRoot" ItemsSource="{Binding NavigationGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="0,0,0,6"
                                              Padding="4,4,4,2"
                                              Background="Transparent"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource AppCardBorderBrush}">
                                        <Expander.Header>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="2,2"
                                                            Padding="8,7"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.SelectNavItemCommand, ElementName=NavGroupsRoot}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ItemBg"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="7"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource AppCardInnerBackgroundBrush}" />
                                                                                </Trigger>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource AppCardInnerBackgroundBrush}" />
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    CornerRadius="2"
                                                                    Background="{DynamicResource AppAccentBrush}"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3"
                                                                    MinWidth="22"
                                                                    Height="22"
                                                                    Padding="6,2"
                                                                    CornerRadius="11"
                                                                    Background="{DynamicResource AppAccentBrush}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding BadgeCount}"
                                                                           Foreground="White"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="{DynamicResource AppCardCornerRadius}"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppCardBorderBrush}">
                <Grid>
                    <ContentControl Content="{Binding ActiveView}" />

                    <!-- Detached Chat Placeholder when Chat is popped out -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="460"
                                Visibility="{Binding IsChatDetachedPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Chat nội bộ đang mở ở cửa sổ riêng"
                                   FontSize="{DynamicResource AppFontSizeHeading}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Bạn có thể kéo cửa sổ Chat thả lại vào cửa sổ chính này hoặc bấm nút bên dưới để gắn lại ngay."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.8"
                                   Margin="0,8,0,16" />
                        <ui:Button Appearance="Primary"
                                   Content="↙ Gắn Chat về cửa sổ chính"
                                   HorizontalAlignment="Center"
                                   Command="{Binding RedockChatToMainCommand}" />
                    </StackPanel>

                    <!-- Drag-and-Drop Redock Visual Indicator -->
                    <Border CornerRadius="{DynamicResource AppCardCornerRadius}"
                            BorderThickness="3"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Background="#550078D4"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsChatDockDropHighlightVisible, Converter={StaticResource BoolToVis}}">
                        <Border Padding="20,12"
                                CornerRadius="10"
                                Background="{DynamicResource AppCardBackgroundBrush}"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="⬇ Thả cửa sổ Chat vào đây để tự động gắn về cửa sổ chính"
                                       FontSize="{DynamicResource AppFontSizeHeading}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppAccentBrush}" />
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</controls:EzFluentWindow>
