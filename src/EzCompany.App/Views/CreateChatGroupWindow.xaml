<controls:EzFluentWindow x:Class="EzCompany.App.Views.CreateChatGroupWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                         xmlns:controls="clr-namespace:EzCompany.App.Controls"
                         Title="Ez Company — Tạo Nhóm Chat Nội bộ Mới"
                         Icon="pack://application:,,,/Assets/EzCompany.ico"
                         FontSize="{DynamicResource AppFontSize}"
                         Width="500"
                         Height="560"
                         MinWidth="420"
                         MinHeight="460"
                         WindowStartupLocation="CenterOwner"
                         ExtendsContentIntoTitleBar="True"
                         WindowBackdropType="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tạo Nhóm Chat Nội bộ Mới" />

        <Border Grid.Row="1"
                Margin="16"
                Padding="{DynamicResource AppCardPadding}"
                CornerRadius="{DynamicResource AppCardCornerRadius}"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppCardBorderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Tên nhóm chat (*)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="GroupNameTextBox"
                                PlaceholderText="Ví dụ: Kế toán - Pháp chế, Dự án Quý IV..."
                                Margin="0,0,0,12" />

                    <TextBlock Text="Tìm và chọn thành viên tham gia" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="MemberFilterTextBox"
                                PlaceholderText="Gõ tên hoặc chức vụ để lọc nhanh..."
                                TextChanged="MemberFilterTextBox_TextChanged"
                                Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="ValidationText"
                               Foreground="#EF4444"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1" Content="Hủy" Click="CancelButton_Click" />
                        <ui:Button Grid.Column="3" Appearance="Primary" Content="Tạo nhóm chat" Click="CreateButton_Click" />
                    </Grid>
                </StackPanel>

                <Border CornerRadius="8"
                        Padding="6"
                        Background="{DynamicResource AppCardInnerBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AppCardBorderBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MembersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4"
                                            Padding="8,6"
                                            CornerRadius="6"
                                            Background="{DynamicResource AppCardBackgroundBrush}">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#22C55E"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#EF4444"
                                                         Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding RoleDisplay}" FontSize="11" Opacity="0.72" />
                                                </StackPanel>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</controls:EzFluentWindow>
