<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EzCompany.App</RootNamespace>
    <AssemblyName>EzCompany.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\EzCompany.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EzCompany.Core.Abstractions\EzCompany.Core.Abstractions.csproj" />
    <ProjectReference Include="..\EzCompany.Core.Crypto\EzCompany.Core.Crypto.csproj" />
    <ProjectReference Include="..\EzCompany.Core.Data\EzCompany.Core.Data.csproj" />
    <ProjectReference Include="..\EzCompany.Core.LanAgent\EzCompany.Core.LanAgent.csproj" />
    <ProjectReference Include="..\EzCompany.Core.Telemetry\EzCompany.Core.Telemetry.csproj" />
    <ProjectReference Include="..\EzCompany.Core.Updater\EzCompany.Core.Updater.csproj" />
    <ProjectReference Include="..\Modules\EzCompany.Modules.Accounting\EzCompany.Modules.Accounting.csproj" />
    <ProjectReference Include="..\Modules\EzCompany.Modules.Legal\EzCompany.Modules.Legal.csproj" />
    <ProjectReference Include="..\Modules\EzCompany.Modules.Office\EzCompany.Modules.Office.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\EzCompany.png" />
    <Resource Include="Assets\EzCompany.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
