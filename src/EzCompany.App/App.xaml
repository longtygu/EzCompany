<Application x:Class="EzCompany.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:EzCompany.App.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:NullOrEmptyToCollapsedConverter x:Key="NotEmptyToVis" />

            <!-- Dynamic customizable appearance tokens -->
            <sys:Double x:Key="AppFontSize">14</sys:Double>
            <sys:Double x:Key="AppFontSizeSmall">12</sys:Double>
            <sys:Double x:Key="AppFontSizeHeading">18</sys:Double>
            <sys:Double x:Key="AppFontSizeTitle">22</sys:Double>
            <sys:Double x:Key="AppCardMaxWidth">1080</sys:Double>
            <CornerRadius x:Key="AppCardCornerRadius">10</CornerRadius>
            <Thickness x:Key="AppCardPadding">16</Thickness>
            <GridLength x:Key="AppSidebarWidth">260</GridLength>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
